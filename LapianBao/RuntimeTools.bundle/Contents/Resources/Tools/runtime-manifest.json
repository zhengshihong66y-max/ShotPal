    }
  ],
  "externalRuntimeDependencies": [
    {
      "id": "yt-dlp",
      "purpose": "Remote video download",
      "currentResolution": "App-managed self-check/download plus PATH fallbacks",
      "packagingNote": "The app can install an app-managed yt-dlp at runtime. A Homebrew wrapper should not be copied into the bundle."
    }
  ],
  "excludedLocalArtifacts": [
    "Tools/music-env",
    "Tools/transnet-env",
    "tmp",
    "output",
    ".codex-derived"
