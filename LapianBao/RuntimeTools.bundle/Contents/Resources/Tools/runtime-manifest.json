{
  "schemaVersion": 1,
  "date": "2026-08-30",
  "bundleResourceRoot": "RuntimeTools.bundle/Contents/Resources",
  "embeddedResources": [
    {
      "id": "yt-dlp",
      "path": "Tools/bin/yt-dlp",
      "required": true,
      "executable": true,
      "purpose": "Pinned official zipimport archive with EJS, invoked by bundled Python; no first-use installation"
    },
    {
      "id": "deno",
      "path": "Tools/bin/deno",
      "required": true,
      "executable": true,
      "architecture": "arm64",
      "purpose": "Offline JavaScript challenge runtime for yt-dlp"
    },
    {
      "id": "downloader_manifest",
      "path": "Tools/downloader-manifest.json",
      "required": true,
      "purpose": "Pinned downloader versions, source URLs and SHA256 hashes"
    },
    {
      "id": "whisper_cli",
      "path": "Tools/whisper.cpp/build/bin/whisper-cli",
      "required": true,
      "executable": true,
      "purpose": "Local Whisper transcription runner"
    },
    {
      "id": "whisper_large_v3_turbo_q5_model",
      "path": "Tools/whisper.cpp/models/ggml-large-v3-turbo-q5_0.bin",
      "required": true,
      "minimumBytes": 100000000,
      "purpose": "Default local speech-to-text model"
    },
    {
      "id": "whisper_vad_model",
      "path": "Tools/whisper.cpp/models/for-tests-silero-v6.2.0-ggml.bin",
      "required": false,
      "purpose": "Optional VAD model used by the transcription script"
    },
    {
      "id": "whisper_script",
      "path": "Tools/transcribe_with_whisper.sh",
      "required": true,
      "executable": true,
      "purpose": "Audio extraction and Whisper orchestration"
    },
    {
      "id": "ffmpeg",
      "path": "Tools/bin/ffmpeg",
      "required": true,
      "executable": true,
      "architecture": "universal arm64 x86_64",
      "minimumMacOS": "14.0 on arm64, 13.0 on x86_64",
      "purpose": "Audio/video probing, extraction, export, remote download post-processing"
    },
    {
      "id": "ffprobe",
      "path": "Tools/bin/ffprobe",
      "required": true,
      "executable": true,
      "architecture": "universal arm64 x86_64",
      "minimumMacOS": "14.0 on arm64, 13.0 on x86_64",
      "purpose": "Video probing for detection scripts and import metadata"
    },
    {
      "id": "python_3_11_arm64",
      "path": "Tools/python/cpython-3.11-aarch64-apple-darwin/bin/python3.11",
      "required": true,
      "executable": true,
      "architecture": "arm64",
      "minimumMacOS": "11.0",
      "purpose": "Bundled relocatable Python runtime"
    },
    {
      "id": "python_3_11_x86_64",
      "path": "Tools/python/cpython-3.11-x86_64-apple-darwin/bin/python3.11",
      "required": true,
      "executable": true,
      "architecture": "x86_64",
      "minimumMacOS": "10.15",
      "purpose": "Bundled relocatable Python runtime"
    },
    {
      "id": "music_detection_script",
      "path": "Tools/detect_music.py",
      "required": true,
      "purpose": "Song recognition script"
    },
    {
      "id": "scene_detection_script",
      "path": "Tools/detect_scene_cuts_transnet.py",
      "required": true,
      "purpose": "TransNetV2 scene-cut script"
    },
    {
      "id": "music_requirements",
      "path": "Tools/requirements-music.txt",
      "required": true,
      "purpose": "Build-time music dependency inputs; shipped as locked wheels"
    },
    {
      "id": "transnet_requirements",
      "path": "Tools/requirements-transnet.txt",
      "required": true,
      "purpose": "Build-time scene dependency inputs; shipped as locked wheels"
    },
    {
      "id": "music_env_setup_script",
      "path": "Tools/setup_music_env.sh",
      "required": false,
      "executable": true,
      "purpose": "Manual fallback for recreating the music Python runtime"
    },
    {
      "id": "transnet_env_setup_script",
      "path": "Tools/setup_transnet_env.sh",
      "required": false,
      "executable": true,
      "purpose": "Manual fallback for recreating the TransNet Python runtime"
    },
    {
      "id": "whisper_cpp_license",
      "path": "Tools/third-party-licenses/whisper.cpp-LICENSE",
      "required": true,
      "purpose": "Third-party license notice"
    },
    {
      "id": "ffmpeg_license_notice",
      "path": "Tools/third-party-licenses/FFmpeg-static-binaries.md",
      "required": true,
      "purpose": "FFmpeg source, hash, and license notice"
    },
    {
      "id": "ffmpeg_gplv3_license",
      "path": "Tools/third-party-licenses/FFmpeg-COPYING.GPLv3",
      "required": true,
      "purpose": "GPLv3 license text for the bundled FFmpeg build"
    },
    {
      "id": "python_standalone_notice",
      "path": "Tools/third-party-licenses/python-build-standalone.md",
      "required": true,
      "purpose": "Python standalone runtime source, hash, and license notice"
    }
  ],
  "appManagedRuntimeDependencies": [],
  "externalRuntimeDependencies": [],
  "excludedLocalArtifacts": [
    "Tools/music-env",
    "Tools/transnet-env",
    "tmp",
    "output",
    ".codex-derived"
  ],
  "bundledRecognition": {
    "architecture": "arm64",
    "minimumMacOS": "14.0",
    "python": "3.11",
    "vendorPath": "Tools/recognition/site-packages",
    "manifest": "Tools/recognition/manifest.json",
    "bootstrap": "Tools/recognition_bootstrap.py",
    "firstUseInstallation": false,
    "musicMatchingRequiresNetwork": true
  }
}
